# Winlogbeat configuration for the GOAD elk extension.
# Since 8.0 winlogbeat no longer parses events with local javascript processors:
# the events are parsed by the winlogbeat ingest pipelines in elasticsearch
# (loaded by "winlogbeat setup --pipelines").

winlogbeat.event_logs:
  - name: Application
    ignore_older: 30m
  - name: System
  - name: Security
  - name: Microsoft-Windows-Sysmon/Operational
  - name: Windows PowerShell
    event_id: 400, 403, 600, 800
  - name: Microsoft-Windows-PowerShell/Operational
    event_id: 4103, 4104, 4105, 4106
  - name: ForwardedEvents
    tags: [forwarded]
  - name: Microsoft-Windows-WMI-Activity/Operational
    event_id: 5857,5858,5859,5860,5861

setup.template.settings:
  index.number_of_shards: 1

setup.kibana:
  host: "{{ elk_agent_server }}:5601"

output.elasticsearch:
  hosts: ["{{ elk_agent_server }}:9200"]
  username: "elastic"
  password: "{{ elk_agent_elastic_password }}"
  pipeline: "winlogbeat-%{[agent.version]}-routing"

processors:
  - add_host_metadata:
      when.not.contains.tags: forwarded
  - add_cloud_metadata: ~
